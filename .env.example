# Copy to .env and fill in. Never commit .env.

# Public origin of the gateway (http://localhost:8094 locally, the tunnel/ingress URL in a demo)
PUBLIC_URL=http://localhost:8094
GATEWAY_PORT=8094

# Own role and database in the shared Postgres (../platform, see README "Platform")
USER_DB=inventoco
PASSWORD_DB=change-me

# Daily refresh of store-chain prices (D1, Éxito, Carulla, Agro Fruver) into the shared catalog
INGEST_ENABLED=false
INGEST_ON_START=false
